# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novel_role?schema=public"

# Server-side AI Gateway settings (keep real keys out of git).
AI_PROVIDER="openai-compatible"
AI_API_KEY=""
AI_BASE_URL=""
AI_PLANNING_MODEL=""
AI_WRITING_MODEL=""
AI_CHECK_MODEL=""
AI_EMBEDDING_MODEL=""
