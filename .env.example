# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/novel_role?schema=public"

# Required only when the first account claims an existing/local installation.
# Generate a high-entropy value and keep it server-side, for example: openssl rand -hex 32
AUTH_BOOTSTRAP_TOKEN=""

# Server-side AI Gateway settings (keep real keys out of git).
AI_PROVIDER="openai-compatible"
AI_API_KEY=""
AI_BASE_URL=""
AI_PLANNING_MODEL=""
AI_WRITING_MODEL=""
AI_CHECK_MODEL=""
AI_EMBEDDING_MODEL=""
